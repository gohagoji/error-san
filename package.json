{
  "name": "error-san",
  "version": "0.1.1",
  "description": "Typed error handling: declare, throw, done.",
  "keywords": [
    "typescript",
    "error-handling",
    "typed-errors",
    "result"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gohagoji/error-san.git"
  },
  "homepage": "https://github.com/gohagoji/error-san",
  "bugs": "https://github.com/gohagoji/error-san/issues",
  "type": "module",
  "scripts": {
    "prebuild": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc --project tsconfig.build.json",
    "test": "vitest --typecheck",
    "lint": "biome check --error-on-warnings"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "2.5.12",
    "publint": "^0.3.22",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457"
}
